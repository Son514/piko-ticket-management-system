// use prisma-8

enum Role {
  @@type("pg/text@1")
  customer = "customer"
  agent    = "agent"
  admin    = "admin"
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  username      String?
  name          String?
  passwordHash  String?
  role            Role     @default(customer)
  isActive        Boolean  @default(true)
  deactivatedAt   TimestamptzString?
  posts           Post[]   @relation("TicketAuthor")
  assignedTickets Post[]   @relation("TicketAssignee")
  sessions        Session[]
  resetTokens   PasswordResetToken[]
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  @@index([role])
  @@index([isActive])
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt TimestamptzString
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  @@index([userId])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt TimestamptzString
  usedAt    TimestamptzString?
  createdAt TimestamptzString @default(now())
  @@index([userId])
}

enum TicketCategory {
  @@type("pg/text@1")
  general   = "general"
  account   = "account"
  billing   = "billing"
  technical = "technical"
  feature   = "feature"
}

enum TicketPriority {
  @@type("pg/text@1")
  low    = "low"
  medium = "medium"
  high   = "high"
  urgent = "urgent"
}

enum TicketStatus {
  @@type("pg/text@1")
  open        = "open"
  in_progress = "in_progress"
  waiting     = "waiting"
  resolved    = "resolved"
  closed      = "closed"
}

model Post {
  id          Int      @id @default(autoincrement())
  title       String
  content     String?
  category    TicketCategory @default(general)
  priority    TicketPriority @default(medium)
  status      TicketStatus @default(open)
  author      User     @relation("TicketAuthor", fields: [authorId], references: [id])
  authorId    Int
  assignee    User?    @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId  Int?
  attachments Attachment[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@index([status])
  @@index([assigneeId])
}

model Attachment {
  id          Int      @id @default(autoincrement())
  ticketId    Int
  ticket      Post     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  filename    String
  contentType String
  size        Int
  data        Bytes?
  storageKey  String?
  createdAt   TimestamptzString @default(now())
  @@index([ticketId])
}
