# Copy this file to `.env` and replace the placeholders.
# PostgreSQL connection string. Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Public origin used to build password-reset links.
APP_URL="http://localhost:3000"

# Gmail SMTP. Create an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification). Use the 16-character value, not your Google password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="you@gmail.com"
SMTP_PASS="your-16-character-app-password"
EMAIL_FROM="Piko <you@gmail.com>"

# Prisma Object Store bucket. When these are missing, attachments fall back to Postgres.
S3_ENDPOINT="https://your-bucket-endpoint"
S3_BUCKET="your-bucket-name"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"
S3_REGION="auto"
